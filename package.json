{
  "name": "works",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run build",
    "optimize:photos": "bun run scripts/optimize-photos.ts",
    "optimize:asset": "bun run scripts/optimize-asset.ts",
    "postinstall": "next typegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.4",
    "@vercel/speed-insights": "^2.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "motion": "^12.40.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp"
  ],
  "trustedDependencies": [
    "sharp"
  ]
}
